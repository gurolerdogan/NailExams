APP_ENV=development

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Google Sign-In (from Firebase Console → Authentication → Sign-in method → Google)
# iOS client ID:  Firebase Console → Project settings → Your apps → iOS → GoogleService-Info.plist → CLIENT_ID
# Web client ID:  Firebase Console → Authentication → Sign-in method → Google → Web SDK configuration
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
